{
  "Arn": "arn:aws:ecs:eu-central-1:${AWS_ACCOUNT_ID}:cluster/job-hunter",
  "RoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/jobHunterSchedulerRole",
  "EcsParameters": {
    "TaskDefinitionArn": "arn:aws:ecs:eu-central-1:${AWS_ACCOUNT_ID}:task-definition/job-hunter",
    "LaunchType": "FARGATE",
    "TaskCount": 1,
    "NetworkConfiguration": {
      "awsvpcConfiguration": {
        "Subnets": ["${JOBHUNTER_SUBNET_1}", "${JOBHUNTER_SUBNET_2}"],
        "SecurityGroups": ["${JOBHUNTER_SECURITY_GROUP}"],
        "AssignPublicIp": "ENABLED"
      }
    }
  },
  "RetryPolicy": {"MaximumRetryAttempts": 1, "MaximumEventAgeInSeconds": 3600}
}
