{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PushImageToEcr",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken",
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:DescribeImages"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RegisterNewTaskDefinitionRevision",
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition",
        "ecs:DescribeTaskDefinition",
        "ecs:ListTaskDefinitions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassOnlyTheJobHunterTaskRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/jobHunterTaskRole",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/jobHunterExecutionRole"
      ]
    },
    {
      "Sid": "RunTheJobHunterTaskOnDemand",
      "Effect": "Allow",
      "Action": [
        "ecs:RunTask",
        "ecs:DescribeTasks"
      ],
      "Resource": [
        "arn:aws:ecs:eu-central-1:${AWS_ACCOUNT_ID}:task-definition/job-hunter:*",
        "arn:aws:ecs:eu-central-1:${AWS_ACCOUNT_ID}:task/job-hunter/*"
      ]
    }
  ]
}