{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunOnlyTheJobHunterTask",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:eu-central-1:${AWS_ACCOUNT_ID}:task-definition/job-hunter:*",
      "Condition": {"ArnEquals": {"ecs:cluster": "arn:aws:ecs:eu-central-1:${AWS_ACCOUNT_ID}:cluster/job-hunter"}}
    },
    {
      "Sid": "PassOnlyTheseTwoRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/jobHunterTaskRole",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/jobHunterExecutionRole"
      ]
    }
  ]
}
